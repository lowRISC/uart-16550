name: "lowrisc:prim:diff_decode"
description: "prim"
filesets:
  files_rtl:
    depend:
      - lowrisc:prim:assert
      - lowrisc:prim:flop_2sync
      - lowrisc:prim:xnor2
    files:
      - rtl/prim_diff_decode.sv
    file_type: systemVerilogSource

  files_verilator_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
    files:
      - lint/prim_diff_decode.vlt
    file_type: vlt

targets:
  default:
    filesets:
      - tool_verilator ? (files_verilator_waiver)
      - files_rtl
