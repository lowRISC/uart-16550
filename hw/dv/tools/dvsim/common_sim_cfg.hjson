// Project-wide DVSim simulation settings.
//
// Adapted from OpenTitan hw/dv/tools/dvsim/common_sim_cfg.hjson and
// hw/data/common_project_cfg.hjson (at the lowrisc_ip lock revision). The differences are that
// dv_root points at the vendored OpenTitan DV code, the project settings are inline, and the
// nightly regression does not enable coverage (coverage is later work).
{
  flow: sim

  project:          uart16550
  repo_server:      "github.com/lowRISC/uart-16550"
  book:             ""
  doc_server:       ""
  results_server:   ""

  // OpenTitan DV libraries and tool configuration (hw/vendor/lowrisc_ip.vendor.hjson)
  dv_root:          "{proj_root}/hw/vendor/lowrisc_ip/dv"
  flow_makefile:    "{dv_root}/tools/dvsim/sim.mk"

  import_cfgs:      ["{dv_root}/tools/dvsim/common_modes.hjson",
                     "{dv_root}/tools/dvsim/fusesoc.hjson",
                     "{dv_root}/tools/dvsim/bazel.hjson",
                     "{dv_root}/tools/dvsim/{tool}.hjson"]

  sv_flist_gen_flags: ["--mapping=lowrisc:prim_generic:all:0.1"]

  scratch_base_path:  "{scratch_root}/{branch}"
  scratch_path:       "{scratch_base_path}/{dut}-{flow}-{tool}"

  build_dir:          "{scratch_path}/{build_mode}"
  run_dir_name:       "{index}.{test}"
  run_dir:            "{scratch_path}/{run_dir_name}/latest"
  sw_root_dir:        "{proj_root}/sw"

  build_seed_file_path: "{build_dir}/build_seed.log"

  build_pass_patterns: []
  build_fail_patterns: []

  // "TEST PASSED CHECKS" is printed by dv_report_server when there was no UVM_WARNING,
  // UVM_ERROR or UVM_FATAL. Blocks may add further required patterns.
  run_pass_patterns:   ["^TEST PASSED (UVM_)?CHECKS$"]
  run_fail_patterns:   ["^UVM_ERROR\\s[^:].*$",
                        "^UVM_FATAL\\s[^:].*$",
                        "^UVM_WARNING\\s[^:].*$",
                        "^Assert failed: ",
                        "^\\s*Offending '.*'",
                        "^TEST FAILED (UVM_)?CHECKS$",
                        "^Error:.*$"]

  results_server_prefix: ""
  results_server_cmd:    ""
  results_html_name:     "report.html"

  revision: '''{eval_cmd}
            COMMIT_L=`git -C {proj_root} rev-parse HEAD`; \
            COMMIT_S=`git -C {proj_root} rev-parse --short HEAD`; \
            printf "GitHub Revision: [\`$COMMIT_S\`](https://{repo_server}/tree/$COMMIT_L)"
            '''

  tl_aw: 32
  tl_dw: 32
  tl_dbw: 4

  expand_uvm_verbosity_n: UVM_NONE
  expand_uvm_verbosity_l: UVM_LOW
  expand_uvm_verbosity_m: UVM_MEDIUM
  expand_uvm_verbosity_h: UVM_HIGH
  expand_uvm_verbosity_f: UVM_FULL
  expand_uvm_verbosity_d: UVM_DEBUG
  verbosity: l

  dut_instance: "{tb}.dut"
  timescale: "1ns/1ps"
  sim_tops: ["{tb}"]

  build_opts: ["+define+UVM",
               "+define+UVM_NO_DEPRECATED",
               "+define+UVM_REGEX_NO_DPI",
               "+define+UVM_REG_ADDR_WIDTH={tl_aw}",
               "+define+UVM_REG_DATA_WIDTH={tl_dw}",
               "+define+UVM_REG_BYTENABLE_WIDTH={tl_dbw}",
               "+define+SIMULATION",
               "+define+DUT_HIER={dut_instance}"]

  run_opts: ["+UVM_NO_RELNOTES",
             "+UVM_VERBOSITY={expand_uvm_verbosity_{verbosity}}"]

  exports: [
    { SCRATCH_PATH: "{scratch_path}" },
    { proj_root: "{proj_root}" },
    { dv_root: "{dv_root}" },
    { self_dir: "{self_dir}" },
    { SIMULATOR: "{tool}" },
    { GUI: "{gui}"},
    { GUI_DEBUG: "{gui_debug}"},
    { WAVES: "{waves}" },
    { DUT_TOP: "{dut}" },
    { TB_TOP: "{tb}" },
    { dut_instance: "{dut_instance}" }
  ]

  build_modes: []

  regressions: [
    {
      name: smoke
      tests: []
      reseed: 1
      run_opts: ["+smoke_test=1"]
    }
    {
      name: all
    }
    {
      name: all_once
      reseed: 1
    }
    {
      name: nightly
    }
  ]

  // Xcelium coverage configuration, used only if the cov sim mode is enabled.
  xcelium_cov_cfg_file: "{{build_mode}_xcelium_cov_cfg_file}"
  xcelium_unr_cfg_file:  "{dv_root}/tools/xcelium/unr.cfg"
  xcelium_cov_excl_script: "{dv_root}/tools/xcelium/common_cov_excl.tcl"
  xcelium_cov_refine_files: []
  default_xcelium_cov_cfg_file: "{dv_root}/tools/xcelium/cover.ccf"
}
